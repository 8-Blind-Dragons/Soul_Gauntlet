  "language_map": {
    "en_us": {
      "item.soul_gauntlet.soulgauntlet": "Soul Gauntlet",
      "advancements.soulgauntletachievement_2.descr": "Find the church",
      "advancements.soulgauntletachievement_5.title": "First Soul",
